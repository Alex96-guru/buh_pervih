# Скопируйте в .env и подставьте свои значения. Сам .env в гит не попадает.

# Локальная разработка — Postgres из docker-compose.yml:
DATABASE_URL=postgres://buh:buh_local_dev@localhost:5432/buh_pervih

# В Railway APP_ORIGIN может быть не задан: сервер использует системный RAILWAY_PUBLIC_DOMAIN.
# Для собственного домена задайте APP_ORIGIN с его HTTPS-адресом.
# Для локальной тестовой оплаты укажите адрес фронтенда Vite:
APP_ORIGIN=http://localhost:5173
# На Railway: APP_ORIGIN=https://example.com
# DATABASE_CA_CERT=... (только если для внешнего PostgreSQL нужен собственный CA)

# Только локальная разработка: тестовая оплата инструкций без списания денег.
ENABLE_TEST_PAYMENTS=false
# Email аккаунта Ольги с ролью admin. По умолчанию admin@gmail.com.
INSTRUCTION_MANAGER_EMAIL=olga@example.com

# На Railway переменная подставляется сама, если связать сервис сайта с сервисом
# Postgres: там это ссылка вида ${{Postgres.DATABASE_URL}} по внутренней сети.
# Вручную её прописывать не нужно.
